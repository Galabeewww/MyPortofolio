# ===================================================================
# MYPORTOFOLIO ENVIRONMENT TEMPLATE (.env.example)
# Panduan Lengkap Konfigurasi Database & API
# ===================================================================

# -------------------------------------------------------------------
# 🌐 MODE 1: ONLINE DATABASE (Supabase + Prisma ORM)
# -------------------------------------------------------------------
# Gunakan mode ini untuk deploy ke Vercel atau production server.
# Cara Mendapatkan Connection String:
# 1. Buka https://app.supabase.com → Pilih Project Anda
# 2. Buka Project Settings → Database → Connection String → URI
# 3. Copy URL Mode Session (DATABASE_URL) dan Direct Mode (DIRECT_URL)

DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Kredensial API Client Supabase (Project Settings → API)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"


# -------------------------------------------------------------------
# 💻 MODE 2: LOKAL DATABASE (PostgreSQL / pgAdmin)
# -------------------------------------------------------------------
# Gunakan mode ini saat pengembangan di komputer lokal.
# SYARAT UTAMA: Wajib membuat database bernama 'portfolio_db' di pgAdmin!
# Jika database 'portfolio_db' belum dibuat, admin TIDAK BISA LOGIN!

PG_HOST="localhost"
PG_PORT=5432
PG_DATABASE="portfolio_db"
PG_USER="postgres"
PG_PASSWORD="your_postgres_password"

# Port Server Backend API Express & Endpoint Client Frontend
SERVER_PORT=3001
VITE_LOCAL_API_URL="http://localhost:3001/api"

VITE_WEB3FORMS_KEY=Access_Key_Anda_Yg_Dari_Web3Forms_Disini
